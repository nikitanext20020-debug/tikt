# Telegram Bot Token (REQUIRED)
# Get it from @BotFather on Telegram
WM_TELEGRAM_TOKEN=your_bot_token_here

# Admin User ID (REQUIRED)
# Send /start to @userinfobot to get your ID
WM_ADMIN_ID=your_telegram_id_here

# Proxy URL (OPTIONAL)
# Format: socks5://user:pass@host:port or http://host:port
# Leave empty if not needed
PROXY_URL=

# YouTube Cookies (OPTIONAL - for YouTube downloads)
# 1. Install browser extension "Get cookies.txt LOCALLY"
# 2. Open YouTube.com (login if needed)
# 3. Click extension icon → Export cookies
# 4. Copy ALL content from the exported file
# 5. Paste as value for YOUTUBE_COOKIES variable in Railway
#
# Example format (Netscape format):
# .youtube.com	TRUE	/	FALSE	0	VISITOR_INFO1_LIVE	your_value_here
# .youtube.com	TRUE	/	FALSE	0	PREF	f1=50000000&f6=8
# .youtube.com	TRUE	/	FALSE	0	YSC	your_value_here
#
# Watermark settings (OPTIONAL)
WATERMARK_POSITION=bottom-right
WATERMARK_OPACITY=0.7
WATERMARK_SCALE=0.17
WATERMARK_MARGIN=20

# FFmpeg settings (OPTIONAL)
FFMPEG_PRESET=fast
FFMPEG_CRF=25
